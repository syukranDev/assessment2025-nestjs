							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"mutation { login(input: { username: \\\"superadmin\\\", password: \\\"Amast@123\\\" }) { access_token user { id username email profile { first_name last_name age } } } }\"\n}"
						},
