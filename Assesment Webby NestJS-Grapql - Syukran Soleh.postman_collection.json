						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.login && response.data.login.access_token) {",
									"        pm.collectionVariables.set('jwtToken', response.data.login.access_token);",
									"        console.log('JWT Token saved:', response.data.login.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
